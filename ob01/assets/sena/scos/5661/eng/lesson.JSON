{"_data": [{"contents": [{"content": "Sally Comes Home", "type": "lesson_name"}, {"content": "Waiting for Luggage", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 14, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Describe rooms, homes and objects in buildings in common social and work situations.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Making and Responding to Requests", "type": "heading"}, {"content": " When you make and respond to requests, remember to be polite!", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Making Requests </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Responding to Requests </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would you \u2026 ?<br />  I'd like to \u2026 <br /> Would you mind (if) \u2026 ?<br />  Would \u2026 be okay?<br />  I was wondering if \u2026 <br />  Could you \u2026 ?<br />  Do you think you could \u2026 ?<br /> Is there any chance you could \u2026 ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sure, I'll \u2026<br />  Sure, I'd be glad to \u2026<br /> No, not at all.<br /> Certainly.<br /> Yes, of course.<br /> I'll see what I can do.<br /> I don't mind at all.<br /> Of course we can \u2026<br /> No problem.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "<span class =\"strong\">Ann</span>: Would you mind telling me where the baggage claim area is?   ", "type": "example"}, {"content": "<span class =\"strong\">Attendant</span>: Not at all. Take the escalator to your right. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": " Comparative and Superlative Adjectives", "type": "heading"}, {"content": "You use a comparative to compare somebody or something to <span class =\"strong\">one</span> other person or thing.<br /> You use a superlative to compare somebody or something to the whole <span class =\"strong\">group</span> that he, she or it belongs to.", "type": "describer"}, {"content": "<ul>  \t<li>You use <span class =\"strong\">than</span> after the comparative</li> \t<li>You add <span class =\"strong\">the</span> in front of the superlative form to describe people, places and things</li> </ul>   \t\t\t", "type": "text"}, {"content": "Look at the chart for information on how to form the comparative and superlatives:", "type": "text"}, {"content": "{\"rows\":7,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Comparative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Superlative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cold\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"colder (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" the coldest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Most adjectives: +-er, +-est\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"big\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" bigger (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" the biggest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"1-syllable words, with a consonant + a vowel + a consonant (cvc) at the end, double the final consonant + -er\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"late\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"later (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the latest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adjectives ending in -e: +-r, +-st\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"happy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"happier (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the happiest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2-syllable adjectives ending in -y: +-ier, +iest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"attractive\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"more attractive (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the most attractive\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3+-syllable adjectives:  more + adjective + than <br> or<br>the most + adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"good<br />bad\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"better (than)<br /> worse (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the best<br /> the worst\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Irregular comparisons\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "Boston is colder than Cairo. ", "type": "example"}, {"content": "Cairo is bigger than Boston.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "time zone", "type": "name"}, {"content": "an area of the globe where clocks show the same time ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Boston is in the Eastern Time Zone and is 6 hours behind Cairo.", "type": "example"}, {"content": "engenn5le14ob01aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you hear in an airport at the Arrivals Hall.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "jet lag", "type": "name"}, {"content": "physical effects you feel after a long trip across several time zones ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I don't deal with jet lag very well.", "type": "example"}, {"content": "engenn5le14ob01aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "pamphlet", "type": "name"}, {"content": "a short booklet containing information about a subject ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to pick up a pamphlet on how to deal with jet lag.", "type": "example"}, {"content": "engenn5le14ob01aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "flight", "type": "name"}, {"content": "the process of traveling through the air", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The flight to Boston was long and tiring.", "type": "example"}, {"content": "engenn5le14ob01aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "turbulence", "type": "name"}, {"content": "an area of rough air during flight ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The plane entered an area of turbulence.", "type": "example"}, {"content": "engenn5le14ob01aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to adjust ", "type": "name"}, {"content": "to get used to something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I need a few days to adjust to the time zone.", "type": "example"}, {"content": "engenn5le14ob01aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "border protection ", "type": "name"}, {"content": "the process of showing your passport before entering a country", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The line for border protection was very long.", "type": "example"}, {"content": "engenn5le14ob01aud07", "type": "audio"}], "type": "target_word"}, {"content": "engenn5le14ob01re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Go online and look for a list of tips on how to deal with jet lag.", "type": "text"}, {"content": "Write down a list of 8-10 tips.", "type": "text"}, {"content": "Share the tips with your partner. Listen to your partner's tips.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I talk about travel and transportation.", "type": "text"}, {"content": "I write a list of tips for dealing with jet lag.", "type": "text"}, {"content": "I compare my list with other people's lists in my class.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le14ob01re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le14ob01re2img05.jpg", "time": "100", "id": 1, "text": "<span class =\"strong prelo-dialogue-110\">Sally</span>: Excuse me \u2026 ?<br />\n<span class =\"strong\">Airport attendant</span>: Yes, how may I help you?<br />\n<span class =\"strong\">Sally</span>: Would you mind telling me where the baggage claim area is?<br />\n<span class =\"strong\">Airport attendant</span>: Not at all. Take the escalator down to the Arrivals Hall.<br />\n<span class =\"strong\">Sally</span>: The escalator right here?"}, {"image": "engenn5le14ob01re2img01.jpg", "time": "11000", "id": 2, "text": "<span class =\"strong prelo-dialogue-110\">Airport attendant</span>: Yes. Follow the sign and look for your flight number on the big screen.<br />\n<span class =\"strong\">Sally</span>: Thank you. Could you tell me where the restroom is?<br />\n<span class =\"strong\">Airport attendant</span>: Certainly. It's at the end of the baggage claim area. Are you feeling ok?<br />\n<span class =\"strong\">Sally</span>: Yes \u2026 it's just the jet lag. I need time to adjust to the time zone.<br />\n<span class =\"strong\">Airport attendant</span>: It always takes a few days. Where did you depart from?"}, {"image": "engenn5le14ob01re2img05.jpg", "time": "31500", "id": 3, "text": "<span class =\"strong prelo-dialogue-110\">Sally</span>: Cairo. It was a long flight. We had a bit of turbulence as well, so I didn't sleep at all.<br />\n<span class =\"strong\">Airport attendant</span>: Boston is 6 hours behind Cairo. <br />\n<span class =\"strong\">Sally</span>: It's also much colder! I had to wear a jacket in the line for border protection!<br />\n<span class =\"strong\">Airport attendant</span>: Aw, I'm sorry. Would you like a pamphlet about dealing with jet lag?<br />\n<span class =\"strong\">Sally</span>: Sure ..."}], "audiosrc": "engenn5le14ob01re2aud01", "coverimg": "engenn5le14ob01re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about travel and transportation. ", "type": "Learning Outcomes"}, {"content": " I can make and respond to requests. ", "type": "Learning Outcomes"}, {"content": " I can compare two things.", "type": "Learning Outcomes"}, {"content": "Do you like traveling by plane? ", "type": "Free Header Item"}, {"content": "Are you a nervous flyer? Are you relaxed? ", "type": "Free Header Item"}, {"content": "What do you like to do onboard a plane? ", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": " Ask your partner:", "type": "free_header_text"}, {"content": " Sally is back in Boston. It's good to be home!", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " Sally is <span class=\"tool-tip\" id=\"tip_1_0\">jet lagged</span> after her flight. She can't find the <span class=\"tool-tip\" id=\"tip_1_1\">baggage claim</span> area.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"