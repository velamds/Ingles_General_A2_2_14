{"_data": [{"type": "metadata", "contents": [{"content": "Sally Comes Home", "type": "lesson_name"}, {"content": "Finally Home", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 14, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe rooms, homes and objects in buildings in common social and work situations.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_8"}]}, {"content": "engenn5le14ob04re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "One syllable Words With Silent <span class=\"italic\">e</span>", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "There are 5 spelling rules for the silent <span class=\"italic\">e</span>.", "type": "text"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rules\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"1. A final <span class=\\\"italic\\\">e </span>makes the vowel say its name.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">cut</br>cute</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2. English words don't end in<span class=\\\"italic\\\"> v </span>or <span class=\\\"italic\\\">u</span>.</p> The<span class=\\\"italic\\\"> e</span> after <span class=\\\"italic\\\">v</span> or <span class=\\\"italic\\\">u</span> does not affect pronunciation.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">have</br>blue</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3. Silent <span class=\\\"italic\\\">e </span>after the letter <span class=\\\"italic\\\">c </span>and<br/><span class=\\\"italic\\\">g</span> \u201csoften\u201d their sounds.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">rage</br>cabbage</br>face</br>experience</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"4. Every syllable must have a vowel. The final syllable can be pronounced without a vowel but every syllable must have a vowel.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">tackle</br>pickle</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"5. Sometimes the silent final <span class=\\\"italic\\\">e</span> has no purpose.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">are</br>were</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": "Weak Forms", "type": "heading"}, {"content": "Weak forms happen on small, less important words that link the operative, key <span class=\"strong\">content words</span> of a sentence together. ", "type": "describer"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Less Important Words\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Examples: <span class=\\\"italic\\\">am, are, be, been, can, could, do, does, has, was</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Prepositions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">at, for, from, of, to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pronouns\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">he, her, him, his, me, she, them, us, we, you, your</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verbs\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">am, is, was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Conjunctions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">and, but, or, than, that</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Articles\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">a, the, an</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "stuffed animal", "type": "name"}, {"content": "a toy in the shape of an animal that usually has fake fur and is filled with soft material", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I love my old stuffed animals.", "type": "example"}, {"content": "engenn5le14ob04aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you talk about a room in a house.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "closet", "type": "name"}, {"content": "a small room that is used for storing things", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are a lot of old clothes in my closet.", "type": "example"}, {"content": "engenn5le14ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "poster", "type": "name"}, {"content": "a large picture that is put on walls as a decoration", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I kept your toys and posters.", "type": "example"}, {"content": "engenn5le14ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "memento", "type": "name"}, {"content": "something that is kept as a reminder of a person, place, or thing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'll take Pugsly back to my apartment as a little momento.", "type": "example"}, {"content": "engenn5le14ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "comforter", "type": "name"}, {"content": "a thick bed covering that is filled with a soft light material", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You even kept my old unicorn comforter with the rainbows.", "type": "example"}, {"content": "engenn5le14ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "goth", "type": "name"}, {"content": "a person who listens to or performs goth music, wears mostly black clothing, uses black and white makeup, and often has dyed black hair", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I was in my goth phase.", "type": "example"}, {"content": "engenn5le14ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "phase", "type": "name"}, {"content": "a short period of time during which a person behaves in a particular way or likes a particular thing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: That was a challenging phase in my life.", "type": "example"}, {"content": "engenn5le14ob04aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "unicorn", "type": "name"}, {"content": "an imaginary animal that looks like a horse and has a straight horn growing from the middle of its forehead", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have a unicorn comforter from my childhood.", "type": "example"}, {"content": "engenn5le14ob04aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Make a list of 10 objects you have from your childhood.", "type": "text"}, {"content": "Choose 5 things and write a sentence for each.", "type": "text"}, {"content": "With a partner, explain why you still have these items.  Why are they important to you?", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I make a list of important items from my past.", "type": "text"}, {"content": "I write 5 sentences about these items.", "type": "text"}, {"content": "I explain why I still have them to a partner.", "type": "text"}]}], "labs": [{"exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "I can use and say words with the silent e.", "type": "L